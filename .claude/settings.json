{
  "permissions": {
    "allow": [
      "mcp__Scite_mcp",
      "mcp__PubMed",
      "mcp__bioRxiv"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "xai-grok-build": {
      "source": {
        "source": "github",
        "repo": "xai-org/grok-build-plugin-cc"
      }
    }
  },
  "enabledPlugins": {
    "grok-build@xai-grok-build": true
  }
}
